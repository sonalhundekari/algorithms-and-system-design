<Project Sdk="Microsoft.NET.Sdk">

  <!-- Separate project because this one needs the StackExchange.Redis package
       and a live Redis on localhost:6379. Keeping it out of CodingPatterns lets
       that project build and run with no external dependencies at all. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CodingPatterns.RedisRateLimiterDemo</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

</Project>
